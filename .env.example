# Where the project lives
PROJECT_ROOT="/mnt/docker/sql_health_data_importer"

# Virtualenv
VENV_DIR="/mnt/docker/sql_health_data_importer/venv"

# Main importer script
IMPORTER_SCRIPT="/mnt/docker/sql_health_data_importer/health_data_importer.py"

# New pipeline/fetch scripts
PIPELINE_SCRIPT="/mnt/docker/sql_health_data_importer/run_pipeline.sh"
FETCH_SCRIPT="/mnt/docker/sql_health_data_importer/fetch_health_connect.sh"

# Logging
LOG_FILE="/mnt/docker/sql_health_data_importer/full_import_log.txt"
FETCH_LOG_FILE="/mnt/docker/sql_health_data_importer/health_connect_fetch.log"
SERVICE_LOG_FILE="/mnt/docker/sql_health_data_importer/pipeline.log"

# Source backend: rclone or raidrive
CLOUD_BACKEND="rclone"

# Recommended: rclone without a mount
RCLONE_REMOTE="gdrive"
RCLONE_USE_MOUNT="false"

# Only needed if using a mount
MOUNT_DIR="/mnt/google-healthconnect"

# Path inside Google Drive
ZIP_RELATIVE_PATH="Health Connect.zip"

# Working directory
WORK_DIR="/mnt/docker/sql_health_data_importer/.work"

# Destination mode:
# local = same box as importer
# scp   = different Linux box, send DB to your server
TARGET_MODE="local"

# Local destination for renamed DB
LOCAL_DB_DEST="/mnt/docker/sql_health_data_importer/health_data.db"

# If TARGET_MODE=scp
SSH_PRIVATE_KEY="/root/.ssh/keytoproxdeb_new"
REMOTE_SCP_TARGET="root@192.168.1.112:/mnt/docker/sql_health_data_importer/"

# If local, run importer right after fetch
RUN_IMPORT_AFTER_FETCH="true"

# Optional: after SCP, trigger remote import too
RUN_REMOTE_IMPORT_AFTER_SCP="false"
REMOTE_SSH_HOST="root@192.168.1.112"
REMOTE_IMPORT_COMMAND="systemctl start health-connect-pipeline.service"

# Importer uses this DB path
SQLITE_DB_PATH="/mnt/docker/sql_health_data_importer/health_data.db"

# PostgreSQL connection
PGHOST="your_database_host"
PGPORT="5432"
PGDATABASE="your_database_name"
PGUSER="your_user"
PGPASSWORD="your_database_password"

TABLES_TO_IMPORT="steps_record_table,body_fat_record_table,weight_record_table,speed_record_table,sleep_session_record_table,distance_record_table"

SERVICE_NAME="health-connect-pipeline"
TIMER_NAME="health-connect-pipeline"

SERVICE_USER="your_linux_user"

SERVICE_DESCRIPTION="Health Connect Fetch + SQL Importer"
TIMER_DESCRIPTION="Run Health Connect pipeline on a schedule"

ONCALENDAR="*-*-* 00:10:00"

SYSTEMD_DIR="/etc/systemd/system"

EXTRA_PIP_PACKAGES="requests"
